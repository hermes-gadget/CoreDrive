[Unit]
Description=CoreDrive nightly database dump
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ben
WorkingDirectory=/home/ben/coredrive/repo/deploy
ExecStart=/bin/bash /home/ben/coredrive/repo/deploy/backup.sh
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
